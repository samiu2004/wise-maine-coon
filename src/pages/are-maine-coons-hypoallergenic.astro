.lead-cta { display:inline-flex; align-items:center; gap:20px; padding:13px 18px; color:#fff; background:var(--af-ink); border:1px solid var(--af-ink); border-radius:5px; font-size:.87rem; font-weight:650; text-decoration:none; }
.lead-cta:hover { background:#2a5644; }
.lead-art { margin:0; padding:12px; background:#ebe6d7; border:1px solid #ded7c5; border-radius:12px; transform:rotate(1deg); }
