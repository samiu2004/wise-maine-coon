.allergy-feature .allergy-illustration { margin:32px 0; }
.allergy-feature .allergy-illustration img { width:100%; height:auto; border-radius:8px; margin:0; }
.allergy-feature .allergy-illustration figcaption { margin-top:10px; padding-left:13px; border-left:2px solid #b4bf9a; font-size:.78rem; line-height:1.6; color:var(--af-muted); }
