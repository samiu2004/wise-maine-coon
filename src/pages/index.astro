---
import BaseLayout from "@/layouts/BaseLayout.astro";
import content from "@/data/content.json";

const articles = content.filter((item) => item.type === "POST");
const featured = articles.find((item) => item.path.includes("litter-box")) ?? articles[0];
// A public article with an exported `listing` appears here when published.
// Preview pages do not export a listing and are never shown to readers.
const pageListings = Object.values(import.meta.glob("/src/pages/**/*.astro", { eager: true }))
  .map((module) => (module as { listing?: unknown }).listing)
  .filter((item): item is { title: string; path: string; description: string; published: string; topic: string } =>
    typeof item === "object" && item !== null && "published" in item && "path" in item);
const topicFor = (path: string) => {
  if (path.includes("food") || path.includes("feeding")) return "feeding";
  if (path.includes("size") || path.includes("growth")) return "growth";
  if (path.includes("litter-box")) return "litter";
  return "care";
};
const published = [
  ...articles.map(({ title, path, description, published }) => ({ title, path, description, published, topic: topicFor(path) })),
  ...pageListings
].sort((a, b) => Date.parse(b.published) - Date.parse(a.published));
const topics = [
  { id: "feeding", title: "Feeding", summary: "Food choices, portions and daily routines." },
  { id: "growth", title: "Size & growth", summary: "Weight, development and measuring." },
  { id: "care", title: "Grooming & care", summary: "Coat care, health and everyday life." },
  { id: "litter", title: "Litter boxes", summary: "Sizing, access and product comparisons." }
];
---

<BaseLayout
  title="Maine Coon Care & Feeding Guides"
  description="Practical Maine Coon care, feeding, grooming, growth and litter-box guidance for prospective and first-time owners."
  canonicalPath="/"
  image="/og-home.jpg"
>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Understand your cat. Plan everyday care.</p>
        <h1>Practical Maine Coon care, sizing and home setup.</h1>
        <p>Find a feeding routine, understand growth, manage grooming, or choose a litter-box setup for your cat.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#guides">Explore care guides</a>
          <a class="hero-secondary-link" href="/2026/08/maine-coon-care-guide.html">Start with everyday care</a>
        </div>
      </div>
      <nav class="intent-nav" aria-label="Choose a topic">
        <p>What do you need help with?</p>
        <a href="/2026/08/maine-coon-food-guide.html">Feeding <span>Food, portions and routines</span></a>
        <a href="/2026/08/maine-coon-size-growth-guide.html">Size &amp; growth <span>Weight ranges and development</span></a>
        <a href="/2026/08/maine-coon-grooming-guide.html">Grooming <span>Brushing, shedding and mats</span></a>
        <a href={featured.path}>Litter-box setup <span>Size, access and placement</span></a>
        <a href="/maine-coon-litter-box-comparison.html">Compare litter boxes <span>Eight options and their fit limitations</span></a>
      </nav>
    </div>
  </section>

  <section class="featured-guide section-shell" aria-labelledby="featured-title">
    <div class="featured-image">
      {featured.heroImage && <img src={featured.heroImage} alt="Maine Coon at home" width="1125" height="750" loading="lazy" decoding="async" fetchpriority="low" />}
    </div>
    <div class="featured-copy">
      <p class="eyebrow">Featured decision guide</p>
      <h2 id="featured-title">{featured.title}</h2>
      <p>{featured.description}</p>
      <a class="text-link" href={featured.path}>Read the Maine Coon litter-box guide <span aria-hidden="true">→</span></a>
      <a class="text-link" href="/maine-coon-litter-box-comparison.html">Compare eight litter boxes <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="latest-articles section-shell" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Recently published</p>
        <h2 id="latest-title">Latest articles</h2>
      </div>
      <p>Start with the newest research-based guide, then explore the topic that matters to you.</p>
    </div>
    <div class="latest-grid">
      {published.slice(0, 3).map((article) => (
        <article class="latest-card">
          <time datetime={article.published}>{new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(article.published))}</time>
          <h3><a href={article.path}>{article.title}</a></h3>
          <p>{article.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="guides section-shell" id="guides" aria-labelledby="guides-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Explore by need</p>
        <h2 id="guides-title">Guides for everyday decisions.</h2>
      </div>
      <p>Start with the question you have today, then follow related guides for the next step in your cat’s care.</p>
    </div>
    <div class="topic-grid">
      {topics.map((topic) => (
        <section class="topic-card" id={topic.id} aria-labelledby={`${topic.id}-title`}>
          <h3 id={`${topic.id}-title`}>{topic.title}</h3>
          <p>{topic.summary}</p>
          <ul>
            {published.filter((article) => article.topic === topic.id).map((article) => (
              <li><a href={article.path}>{article.title}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="method-band">
    <div class="section-shell method-grid">
      <div>
        <p class="eyebrow">Transparent by design</p>
        <h2>How we research our guides.</h2>
      </div>
      <div>
        <p>Wise Maine Coon uses veterinary and institutional sources, published product specifications and clearly labeled limitations. We correct errors and distinguish general education from veterinary advice.</p>
        <a class="text-link light-link" href="/p/editorial-policy.html">Read the editorial policy <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
