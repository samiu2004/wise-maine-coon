{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wise-maine-coon",
  "compatibility_date": "2026-09-16",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
